    "BR-12": {
      "agent_label": "Customer Type",
      "name": "Customer Type Classification",
      "prompt_file": "Business_Rule_12_Customer_Type_Classification_Prompt.txt",
      "execution_scope": "invoice",
      "allowed_issue_types": [
        "COUNTRY_NOT_DETERMINED",
        "COUNTRY_CONTEXT_CONFLICT",
        "COUNTRY_PROFILE_NOT_CONFIGURED",
        "CONFLICTING_PROFILE_CONTEXT",
        "CUSTOMER_TYPE_UNDETERMINED",
        "CUSTOMER_TYPE_MISMATCH",
        "CONFLICTING_CUSTOMER_SIGNALS",
        "CONFLICTING_REPEATED_CUSTOMER_FIELDS",
        "PLACEHOLDER_OR_DUMMY_IDENTIFIER",
        "MISSING_BUYER_IDENTIFIER",
        "INVALID_BUYER_VAT_FORMAT",
